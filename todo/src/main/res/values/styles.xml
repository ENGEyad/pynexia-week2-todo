<resources>
<style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">#246A5B</item><item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">#F4F5EE</item><item name="android:navigationBarColor">#193F36</item><item name="android:windowBackground">#F4F5EE</item></style>
<style name="Text"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">#193F36</item><item name="android:textSize">16sp</item></style>
<style name="Eyebrow" parent="Text"><item name="android:textColor">#246A5B</item><item name="android:textSize">11sp</item><item name="android:letterSpacing">0.14</item><item name="android:textStyle">bold</item><item name="android:layout_marginTop">20dp</item><item name="android:layout_marginBottom">12dp</item></style>
<style name="Heading" parent="Text"><item name="android:textSize">32sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:lineSpacingExtra">-2dp</item><item name="android:layout_marginBottom">8dp</item></style>
<style name="Muted" parent="Text"><item name="android:textColor">#5C7067</item><item name="android:textSize">14sp</item><item name="android:layout_marginBottom">16dp</item></style>
<style name="Label" parent="Text"><item name="android:textStyle">bold</item><item name="android:textSize">13sp</item><item name="android:layout_marginTop">14dp</item><item name="android:layout_marginBottom">7dp</item></style>
<style name="Input"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">52dp</item><item name="android:padding">12dp</item><item name="android:background">@drawable/input</item><item name="android:textColor">#193F36</item><item name="android:textColorHint">#66766D</item><item name="android:textSize">16sp</item></style>
<style name="Button"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:backgroundTint">#246A5B</item><item name="android:textColor">#FFFFFF</item></style>
<style name="Secondary" parent="Button"><item name="android:backgroundTint">#E1E9DB</item><item name="android:textColor">#193F36</item></style>
<style name="AppTheme" parent="AppThemeBase"/></resources>
