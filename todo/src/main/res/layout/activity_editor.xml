<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F5EE" android:importantForAutofill="noExcludeDescendants"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView style="@style/Eyebrow" android:text="@string/eyebrow"/><TextView android:id="@+id/editor_heading" style="@style/Heading"/>
<TextView style="@style/Label" android:labelFor="@id/title_input" android:text="@string/title_label"/><EditText android:id="@+id/title_input" style="@style/Input" android:inputType="textCapSentences" android:singleLine="true"/>
<TextView style="@style/Label" android:labelFor="@id/body_input" android:text="@string/body_label"/><EditText android:id="@+id/body_input" style="@style/Input" android:inputType="textMultiLine|textCapSentences" android:minLines="4" android:gravity="top|start"/>
<LinearLayout android:id="@+id/extra_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView style="@style/Label" android:labelFor="@id/extra_input" android:text="@string/email_label"/><EditText android:id="@+id/extra_input" style="@style/Input" android:inputType="textEmailAddress" android:singleLine="true"/></LinearLayout>
<TextView android:id="@+id/error" style="@style/Muted" android:textColor="#A43731" android:accessibilityLiveRegion="polite"/>
<Button android:id="@+id/save" style="@style/Button" android:layout_marginTop="20dp" android:text="@string/save"/><Button android:id="@+id/cancel" style="@style/Secondary" android:text="@string/cancel"/>
</LinearLayout></ScrollView>
